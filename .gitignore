# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# strategy artifacts (large; regenerable from scripts)
/docs/strategy/screenshots/
/docs/strategy/scripts/node_modules/
/docs/strategy/scripts/package-lock.json
/docs/strategy/design-tokens.json

# editor / OS
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshots
/screenshots

# local env file (contains real secrets — do not commit)
ss local env

# python bytecode
__pycache__/
*.pyc

/screenshots

# agent worktree backups (local only — nested git worktrees, noisy)
backup/
# python venv for .engine content pipeline
.venv/
